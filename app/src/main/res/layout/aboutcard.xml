<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="155dp"
    android:layout_height="165dp"
    android:layout_margin="8dp"
    app:cardCornerRadius="24dp"
    android:elevation="10dp"
    app:cardUseCompatPadding="true"
    android:background="@drawable/cardview_border">

    <!-- Container for the card content -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!-- Background image -->
        <ImageView
            android:id="@+id/card_image"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="@string/aboutimage"
            android:scaleType="centerCrop"
            android:src="@drawable/nobita" />

        <!-- Gray overlay and text -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_alignParentBottom="true"
            android:orientation="vertical"
            android:background="@drawable/gradient_foreground">

            <!-- Head Text -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="20dp"
                android:text="@string/pragya_head"
                android:textAlignment="center"
                android:textColor="@color/white"
                android:textSize="14sp"
                android:textStyle="bold"
                tools:ignore="TextSizeCheck,TextSizeCheck" />

            <!-- Subtitle Text -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="25dp"
                android:text="@string/nobita_nobi"
                android:textAlignment="center"
                android:textColor="@color/white"
                android:textSize="19sp"
                android:textStyle="bold"
                tools:ignore="TextSizeCheck" />

        </LinearLayout>

    </RelativeLayout>

</androidx.cardview.widget.CardView>
